+static __always_inline uintptr_t _dl_setup_stack_chk_guard(void)
+{
+	uintptr_t guard;
+	long n;
+
+	/* Wait for the kernel CRNG. Use raw syscalls before the canary exists. */
+	do {
+		n = INTERNAL_SYSCALL(getrandom, , 3, &guard, sizeof(guard), 0);
+	} while (n == -EINTR);
+
+	if (n == (long)sizeof(guard))
+		return guard;
+
+	/* Never enter application code with a time-based or partial canary. */
+	for (;;)
+		INTERNAL_SYSCALL(exit_group, , 1, 127);
+}
