diff --git a/gas/config/tc-subleq.c b/gas/config/tc-subleq.c
new file mode 100644
index 0000000..b6a37ac
--- /dev/null
+++ b/gas/config/tc-subleq.c
@@ -0,0 +1,143 @@
+/* GNU assembler backend for SUBLEQ+.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+#include "as.h"
+#include "safe-ctype.h"
+
+const char comment_chars[] = "#";
+const char line_comment_chars[] = "#";
+const char line_separator_chars[] = ";";
+const char EXP_CHARS[] = "eE";
+const char FLT_CHARS[] = "fFdD";
+
+/* Unlike the generic ELF .word directive, an ISA word is 32 bits.  */
+const pseudo_typeS md_pseudo_table[] = { {"word", cons, 4}, {NULL, NULL, 0} };
+const char md_shortopts[] = "";
+const struct option md_longopts[] = { {NULL, no_argument, NULL, 0} };
+const size_t md_longopts_size = sizeof (md_longopts);
+
+void
+md_begin (void)
+{
+  record_alignment (text_section, 2);
+}
+
+int
+md_parse_option (int code ATTRIBUTE_UNUSED, const char *arg ATTRIBUTE_UNUSED)
+{
+  return 0;
+}
+
+void
+md_show_usage (FILE *stream ATTRIBUTE_UNUSED)
+{
+}
+
+const char *
+md_atof (int type, char *lit, int *size)
+{
+  return ieee_md_atof (type, lit, size, false);
+}
+
+long
+md_pcrel_from (fixS *fix)
+{
+  return fix->fx_frag->fr_address + fix->fx_where;
+}
+
+void
+md_assemble (char *line)
+{
+  expressionS operands[3];
+  char *saved = input_line_pointer;
+  const char mnemonic[] = "subleq";
+
+  if (strncmp (line, mnemonic, sizeof mnemonic - 1) != 0
+      || !ISSPACE (line[sizeof mnemonic - 1]))
+    {
+      as_bad (_("expected `subleq A, B, C'"));
+      return;
+    }
+
+  input_line_pointer = line + sizeof mnemonic - 1;
+  for (unsigned int i = 0; i < 3; ++i)
+    {
+      expression (&operands[i]);
+      SKIP_WHITESPACE ();
+      if (operands[i].X_op == O_absent || operands[i].X_op == O_illegal
+          || (i < 2 && *input_line_pointer++ != ',')
+          || (i == 2 && *input_line_pointer != '\0'))
+        {
+          as_bad (_("expected three comma-separated SUBLEQ word expressions"));
+          input_line_pointer = saved;
+          return;
+        }
+    }
+  input_line_pointer = saved;
+  for (unsigned int i = 0; i < 3; ++i)
+    emit_expr (&operands[i], 4);
+}
+
+void
+subleq_cons_fix_new (fragS *frag, int where, unsigned int size,
+                     expressionS *exp)
+{
+  /* Preserve a positive implicit addend in ET_REL for -(S+A).  The final
+     linker (not GAS) negates the sum.  A folded absolute constant still
+     needs to be negated in md_apply_fix.  */
+  if (exp->X_op == O_uminus && size == 4)
+    {
+      symbolS *sym = exp->X_add_symbol;
+      offsetT addend = - (valueT) exp->X_add_number;
+      if (S_GET_SEGMENT (sym) == expr_section)
+        {
+          const expressionS *inner = symbol_get_value_expression (sym);
+          if (inner->X_op != O_symbol)
+            {
+              /* GAS resolves same-section symbol differences itself.  */
+              fix_new_exp (frag, where, size, exp, 0, BFD_RELOC_32);
+              return;
+            }
+          sym = inner->X_add_symbol;
+          addend += inner->X_add_number;
+        }
+      fix_new (frag, where, size, sym, addend, 0, BFD_RELOC_SUBLEQ_NEG32);
+      return;
+    }
+  /* Non-word constant differences can fold too, but have no ELF reloc.  */
+  fix_new_exp (frag, where, size, exp, 0,
+               size == 4 ? BFD_RELOC_32 : BFD_RELOC_UNUSED);
+}
+
+void
+md_apply_fix (fixS *fix, valueT *value, segT seg ATTRIBUTE_UNUSED)
+{
+  valueT word = *value;
+  if (fix->fx_addsy == NULL && fix->fx_subsy == NULL && !fix->fx_pcrel)
+    {
+      fix->fx_done = 1;
+      if (fix->fx_r_type == BFD_RELOC_SUBLEQ_NEG32)
+        word = 0 - word;
+    }
+  md_number_to_chars (fix->fx_frag->fr_literal + fix->fx_where, word,
+                      fix->fx_size);
+}
+
+arelent *
+tc_gen_reloc (asection *sec ATTRIBUTE_UNUSED, fixS *fix)
+{
+  if (fix->fx_size != 4 || fix->fx_pcrel || fix->fx_subsy != NULL
+      || (fix->fx_r_type != BFD_RELOC_32
+          && fix->fx_r_type != BFD_RELOC_SUBLEQ_NEG32))
+    {
+      as_bad_where (fix->fx_file, fix->fx_line,
+                    _("unsupported SUBLEQ relocation expression"));
+      return NULL;
+    }
+  arelent *rel = notes_alloc (sizeof (*rel));
+  rel->sym_ptr_ptr = notes_alloc (sizeof (*rel->sym_ptr_ptr));
+  *rel->sym_ptr_ptr = symbol_get_bfdsym (fix->fx_addsy);
+  rel->address = fix->fx_frag->fr_address + fix->fx_where;
+  rel->addend = 0; /* REL: the addend is already in the word.  */
+  rel->howto = bfd_reloc_type_lookup (stdoutput, fix->fx_r_type);
+  return rel;
+}
