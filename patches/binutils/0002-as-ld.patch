+/* GAS target definitions for SUBLEQ+.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef TC_SUBLEQ
+#define TC_SUBLEQ 1
+
+#define TARGET_ARCH bfd_arch_subleq
+#define TARGET_MACH bfd_mach_subleq
+#define TARGET_FORMAT "elf32-subleq"
+#define TARGET_BYTES_BIG_ENDIAN 0
+#define WORKING_DOT_WORD
+#define md_number_to_chars number_to_chars_littleendian
+#define md_section_align(SEC, SIZE) (SIZE)
+#define md_undefined_symbol(NAME) NULL
+#define md_operand(EXP) ((void) 0)
+#define md_estimate_size_before_relax(FRAG, SEG) \
+  (as_fatal (_("unexpected SUBLEQ relaxation")), 0)
+#define md_convert_frag(ABFD, SEG, FRAG) \
+  as_fatal (_("unexpected SUBLEQ relaxation"))
+#define MD_APPLY_SYM_VALUE(FIX) 0
+#define TC_CONS_FIX_NEW(FRAG, WHERE, SIZE, EXP, RELOC) \
+  subleq_cons_fix_new (FRAG, WHERE, SIZE, EXP)
+
+extern void subleq_cons_fix_new (fragS *, int, unsigned int, expressionS *);
+
+#endif
