+static reloc_howto_type *
+subleq_reloc_type_lookup (bfd *abfd ATTRIBUTE_UNUSED,
+                          bfd_reloc_code_real_type code)
+{
+  switch (code)
+    {
+    case BFD_RELOC_NONE: return &subleq_howto_none;
+    case BFD_RELOC_32: return &subleq_howto_32;
+    case BFD_RELOC_SUBLEQ_NEG32: return &subleq_howto_neg32;
+    default: return NULL;
+    }
+}
+
+static reloc_howto_type *
+subleq_reloc_name_lookup (bfd *abfd ATTRIBUTE_UNUSED, const char *name)
+{
+  reloc_howto_type *howtos[] = { &subleq_howto_none, &subleq_howto_32,
+                                &subleq_howto_relative, &subleq_howto_neg32 };
+  for (unsigned int i = 0; i < sizeof (howtos) / sizeof (howtos[0]); ++i)
+    if (strcasecmp (name, howtos[i]->name) == 0)
+      return howtos[i];
+  return NULL;
+}
+
+/* The kernel loader directly supplies these symbols.  An arbitrary undefined
+   symbol must never quietly turn into a runtime import.  */
+static const char *const subleq_linux_exports[] = {
+#include "subleq-linux-exports.h"
+};
+
+static int
+subleq_compare_export (const void *key, const void *item)
+{
+  return strcmp (key, *(const char *const *) item);
+}
+
+static bool
+subleq_kernel_import (const char *name)
+{
+  return bsearch (name, subleq_linux_exports,
+                  sizeof (subleq_linux_exports) / sizeof (subleq_linux_exports[0]),
+                  sizeof (subleq_linux_exports[0]), subleq_compare_export) != NULL;
+}
+
+static bool
+subleq_link_error (bfd *abfd, asection *sec, const char *msg)
+{
+  _bfd_error_handler (_("%pB:(%pA): %s"), abfd, sec, msg);
+  bfd_set_error (bfd_error_bad_value);
+  return false;
+}
+
+static struct elf_link_hash_entry *
+subleq_global_symbol (bfd *abfd, unsigned long idx)
+{
+  struct elf_link_hash_entry **hashes = elf_sym_hashes (abfd);
+  if (hashes == NULL)
+    return NULL;
+  struct elf_link_hash_entry *h = hashes[idx - elf_symtab_hdr (abfd).sh_info];
+  while (h != NULL && (h->root.type == bfd_link_hash_indirect
+                       || h->root.type == bfd_link_hash_warning))
+    h = (struct elf_link_hash_entry *) h->root.u.i.link;
+  return h;
+}
+
+static bool
+subleq_create_dynamic_sections (bfd *dynobj, struct bfd_link_info *info)
+{
+  flagword flags = get_elf_backend_data (dynobj)->dynamic_sec_flags;
+  asection *rel = bfd_make_section_anyway_with_flags (dynobj, ".rel.dyn",
+                                                       flags | SEC_READONLY);
+  if (rel == NULL || !bfd_set_section_alignment (rel, 2))
+    return false;
+  elf_section_type (rel) = SHT_REL;
+  if (elf_hash_table (info)->srelrdyn != NULL)
+    elf_section_type (elf_hash_table (info)->srelrdyn) = SHT_RELR;
+  return true;
+}
+
+static bool
+subleq_check_relocs (bfd *abfd, struct bfd_link_info *info, asection *sec,
+                    const Elf_Internal_Rela *relocs)
+{
+  if (!bfd_link_pie (info))
+    return true;
+
+  struct elf_link_hash_table *htab = elf_hash_table (info);
+  if (!bfd_elf_link_create_dynamic_sections (abfd, info))
+    return false;
+  asection *sr = bfd_get_linker_section (htab->dynobj, ".rel.dyn");
+  asection *srr = htab->srelrdyn;
+  Elf_Internal_Shdr *symtab = &elf_symtab_hdr (abfd);
+  struct sym_cache local_cache = { 0 };
+  unsigned long symcount = symtab->sh_size / sizeof (Elf32_External_Sym);
+
+  for (unsigned int i = 0; i < sec->reloc_count; ++i)
+    {
+      const Elf_Internal_Rela *r = relocs + i;
+      unsigned int type = ELF32_R_TYPE (r->r_info);
+      unsigned long idx = ELF32_R_SYM (r->r_info);
+      bool symbolic = false;
+      if (type == R_386_NONE)
+        continue;
+      if (type != R_386_32 && type != R_SUBLEQ_NEG32)
+        return _bfd_unrecognized_reloc (abfd, sec, type);
+      if (idx >= symcount)
+        return subleq_link_error (abfd, sec, _("invalid relocation symbol index"));
+      if (idx < symtab->sh_info)
+        {
+          const Elf_Internal_Sym *s = bfd_sym_from_r_symndx (&local_cache, abfd, idx);
+          if (s == NULL)
+            return false;
+          if (s->st_shndx == SHN_ABS || idx == 0)
+            continue;
+          if (ELF_ST_TYPE (s->st_info) == STT_TLS
+              || ELF_ST_TYPE (s->st_info) == STT_GNU_IFUNC)
+            return subleq_link_error (abfd, sec, _("TLS and IFUNC are not supported"));
+        }
+      else
+        {
+          struct elf_link_hash_entry *h = subleq_global_symbol (abfd, idx);
+          if (h == NULL)
+            return subleq_link_error (abfd, sec, _("invalid global relocation symbol"));
+          if (h->type == STT_TLS || h->type == STT_GNU_IFUNC)
+            return subleq_link_error (abfd, sec, _("TLS and IFUNC are not supported"));
+          if (h->root.type == bfd_link_hash_defined || h->root.type == bfd_link_hash_defweak)
+            {
+              if (bfd_is_abs_section (h->root.u.def.section))
+                continue;
+            }
+          else if (h->root.type == bfd_link_hash_undefined
+                   || h->root.type == bfd_link_hash_undefweak)
+            {
+              symbolic = (ELF_ST_VISIBILITY (h->other) == STV_DEFAULT
+                          && subleq_kernel_import (h->root.root.string));
+              if (!symbolic)
+                continue; /* Final link diagnoses unknown strong undefineds.  */
+              if (!bfd_elf_link_record_dynamic_symbol (info, h))
+                return false;
+            }
+        }
+      if ((r->r_offset & 3) != 0)
+        return subleq_link_error (abfd, sec, _("unaligned runtime relocation"));
+      if ((sec->flags & SEC_READONLY) != 0)
+        info->flags |= DF_TEXTREL;
+      asection *out = !symbolic && type == R_386_32 && srr != NULL ? srr : sr;
+      bfd_size_type entsize = out == srr ? 4 : sizeof (Elf32_External_Rel);
+      if (out->size > (bfd_size_type) -1 - entsize)
+        return subleq_link_error (abfd, sec, _("dynamic relocation section too large"));
+      out->size += entsize;
+    }
+  return true;
+}
+
+static bool
+subleq_size_dynamic_sections (struct bfd_link_info *info)
+{
+  struct elf_link_hash_table *htab = elf_hash_table (info);
+  if (!htab->dynamic_sections_created)
+    return true;
+  asection *sr = bfd_get_linker_section (htab->dynobj, ".rel.dyn");
+  asection *srr = htab->srelrdyn;
+  if (sr->size != 0)
+    {
+      sr->contents = bfd_zmalloc (sr->size);
+      if (sr->contents == NULL
+          || !_bfd_elf_add_dynamic_entry (info, DT_REL, 0)
+          || !_bfd_elf_add_dynamic_entry (info, DT_RELSZ, 0)
+          || !_bfd_elf_add_dynamic_entry (info, DT_RELENT, sizeof (Elf32_External_Rel)))
+        return false;
+    }
+  if (srr != NULL && srr->size != 0)
+    {
+      srr->contents = bfd_zmalloc (srr->size);
+      if (srr->contents == NULL)
+        return false;
+    }
+  if (info->flags & DF_TEXTREL)
+    return _bfd_elf_add_dynamic_entry (info, DT_TEXTREL, 0);
+  return true;
+}
+
+static bool
+subleq_link_add_symbols (bfd *abfd, struct bfd_link_info *info)
+{
+  if (bfd_link_dll (info) || (abfd->flags & DYNAMIC) != 0)
+    {
+      _bfd_error_handler (_("%pB: SUBLEQ Linux ld does not support shared objects"), abfd);
+      bfd_set_error (bfd_error_invalid_operation);
+      return false;
+    }
+  if (bfd_link_pie (info) && !info->nointerp)
+    {
+      _bfd_error_handler (_("SUBLEQ Linux PIE requires --no-dynamic-linker"));
+      bfd_set_error (bfd_error_invalid_operation);
+      return false;
+    }
+  return bfd_elf_link_add_symbols (abfd, info);
+}
+
+static int
+subleq_relocate_section (struct bfd_link_info *info, bfd *abfd, asection *sec,
+                         bfd_byte *contents, Elf_Internal_Rela *relocs,
+                         Elf_Internal_Sym *local_syms, asection **local_sections)
+{
+  Elf_Internal_Shdr *symtab = &elf_symtab_hdr (abfd);
+  unsigned long symcount = symtab->sh_size / sizeof (Elf32_External_Sym);
+  struct elf_link_hash_table *htab = elf_hash_table (info);
+  Elf_Internal_Rela *end = relocs + sec->reloc_count;
+
+  for (Elf_Internal_Rela *r = relocs; r < end; ++r)
+    {
+      unsigned int type = ELF32_R_TYPE (r->r_info);
+      unsigned long idx = ELF32_R_SYM (r->r_info);
+      struct elf_link_hash_entry *h = NULL;
+      asection *def = NULL;
+      bfd_vma value = 0;
+      bool symbolic = false;
+
+      if (type == R_386_NONE)
+        continue;
+      if (type != R_386_32 && type != R_SUBLEQ_NEG32)
+        return _bfd_unrecognized_reloc (abfd, sec, type);
+      if (idx >= symcount || !bfd_reloc_offset_in_range (&subleq_howto_32, abfd, sec, r->r_offset))
+        return subleq_link_error (abfd, sec, _("invalid relocation offset or symbol index"));
+
+      bfd_byte *where = contents + r->r_offset;
+      if (r->r_addend != 0)
+        return subleq_link_error (abfd, sec, _("unexpected SUBLEQ RELA addend"));
+      bfd_vma addend = bfd_get_32 (abfd, where);
+      if (idx < symtab->sh_info)
+        {
+          Elf_Internal_Sym *s = local_syms + idx;
+          def = idx == 0 ? bfd_abs_section_ptr : local_sections[idx];
+          if (def == NULL || def->output_section == NULL)
+            return subleq_link_error (abfd, sec, _("invalid local relocation section"));
+          if (bfd_link_relocatable (info))
+            {
+              if (ELF_ST_TYPE (s->st_info) == STT_SECTION)
+                bfd_put_32 (abfd, addend + def->output_offset, where);
+              continue;
+            }
+          value = addend + s->st_value;
+          if (ELF_ST_TYPE (s->st_info) == STT_SECTION)
+            value = _bfd_elf_rel_local_sym (info->output_bfd, s, &def, addend);
+          value += def->output_section->vma + def->output_offset;
+        }
+      else
+        {
+          h = subleq_global_symbol (abfd, idx);
+          if (h == NULL)
+            return subleq_link_error (abfd, sec, _("invalid global relocation symbol"));
+          if (bfd_link_relocatable (info))
+            continue;
+          if (h->root.type == bfd_link_hash_defined || h->root.type == bfd_link_hash_defweak)
+            {
+              def = h->root.u.def.section;
+              if (def == NULL || def->output_section == NULL)
+                return subleq_link_error (abfd, sec, _("invalid global relocation section"));
+              value = addend + h->root.u.def.value + def->output_section->vma + def->output_offset;
+            }
+          else if (bfd_link_pie (info) && (sec->flags & SEC_ALLOC) != 0
+                   && ELF_ST_VISIBILITY (h->other) == STV_DEFAULT
+                   && subleq_kernel_import (h->root.root.string))
+            {
+              if (h->dynindx <= 0 || h->dynindx > 0xffffff)
+                return subleq_link_error (abfd, sec, _("missing runtime symbol index"));
+              symbolic = true;
+              value = addend;
+            }
+          else if (h->root.type == bfd_link_hash_undefweak)
+            value = addend;
+          else
+            {
+              info->callbacks->undefined_symbol (info, h->root.root.string, abfd,
+                                                 sec, r->r_offset, true);
+              return false;
+            }
+        }
+
+      if (def != NULL && discarded_section (def))
+        RELOC_AGAINST_DISCARDED_SECTION (info, abfd, sec, r, 1, end, R_386_NONE,
+                                         &subleq_howto_32, 0, contents);
+
+      /* A final word stores S+A, or -(S+A).  Dynamic NEG32 records subtract
+         the bias (index zero) or the kernel import address (symbolic).  */
+      bfd_put_32 (abfd, type == R_SUBLEQ_NEG32 ? 0 - value : value, where);
+      if (!bfd_link_pie (info) || (sec->flags & SEC_ALLOC) == 0
+          || (!symbolic && (def == NULL || bfd_is_abs_section (def))))
+        continue;
+
+      bfd_vma offset = _bfd_elf_section_offset (info->output_bfd, info, sec, r->r_offset);
+      if (offset == (bfd_vma) -1 || offset == (bfd_vma) -2)
+        return subleq_link_error (abfd, sec, _("unsupported runtime relocation in adjusted section"));
+      offset += sec->output_section->vma + sec->output_offset;
+      if ((offset & 3) != 0 || offset > 0xffffffffu)
+        return subleq_link_error (abfd, sec, _("runtime relocation address is not a SUBLEQ word"));
+      asection *srr = htab->srelrdyn;
+      if (!symbolic && type == R_386_32 && srr != NULL)
+        {
+          /* Address entries are valid RELR and halve the size of these
+             records without depending on an iterative bitmap layout pass.  */
+          if (srr->reloc_count >= srr->size / 4)
+            return subleq_link_error (abfd, sec, _("RELR size changed after layout"));
+          bfd_put_32 (info->output_bfd, offset, srr->contents + 4 * srr->reloc_count++);
+        }
+      else
+        {
+          asection *sr = bfd_get_linker_section (htab->dynobj, ".rel.dyn");
+          Elf_Internal_Rela dyn = { 0 };
+          if (sr == NULL || sr->reloc_count >= sr->size / sizeof (Elf32_External_Rel))
+            return subleq_link_error (abfd, sec, _("REL size changed after layout"));
+          dyn.r_offset = offset;
+          dyn.r_info = ELF32_R_INFO (symbolic ? h->dynindx : 0,
+                                    !symbolic && type == R_386_32 ? R_386_RELATIVE : type);
+          _bfd_elf_append_rel (info->output_bfd, sr, &dyn);
+        }
+    }
+  return true;
+}
+
+static int
+subleq_compare_relr (const void *p, const void *q)
+{
+  bfd_vma a = bfd_getl32 (p), b = bfd_getl32 (q);
+  return a > b ? 1 : a < b ? -1 : 0;
+}
+
+static bool
+subleq_finish_dynamic_sections (struct bfd_link_info *info,
+                                bfd_byte *contents ATTRIBUTE_UNUSED)
+{
+  struct elf_link_hash_table *htab = elf_hash_table (info);
+  asection *sr = bfd_get_linker_section (htab->dynobj, ".rel.dyn");
+  asection *srr = htab->srelrdyn;
+  if (sr->size / sizeof (Elf32_External_Rel) != sr->reloc_count)
+    return subleq_link_error (htab->dynobj, sr, _("REL count changed after layout"));
+  if (srr != NULL)
+    {
+      if (srr->size / 4 != srr->reloc_count)
+        return subleq_link_error (htab->dynobj, srr, _("RELR count changed after layout"));
+      if (srr->reloc_count != 0)
+        qsort (srr->contents, srr->reloc_count, 4, subleq_compare_relr);
+    }
+  return true;
+}
