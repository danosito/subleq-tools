+extern int print_insn_subleq		(bfd_vma, disassemble_info *);
 extern int print_insn_lm32		(bfd_vma, disassemble_info *);
 extern int print_insn_m32r		(bfd_vma, disassemble_info *);
 extern int print_insn_m68hc11		(bfd_vma, disassemble_info *);
diff --git a/opcodes/subleq-dis.c b/opcodes/subleq-dis.c
new file mode 100644
index 0000000..dd77325
--- /dev/null
+++ b/opcodes/subleq-dis.c
@@ -0,0 +1,90 @@
+/* Disassemble SUBLEQ+ byte-addressed, little-endian instruction triplets.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+
+#include "sysdep.h"
+#include "disassemble.h"
+
+#define SUBLEQ_WORD_SIZE 4
+#define SUBLEQ_INSN_SIZE (3 * SUBLEQ_WORD_SIZE)
+
+static void
+print_operand (bfd_signed_vma raw, disassemble_info *info)
+{
+  /* Bit zero selects indirection.  Signed truncation (not masking off
+     two bits) computes the address for negative I/O and MMIO operands.  */
+  bfd_signed_vma addr = raw / SUBLEQ_WORD_SIZE * SUBLEQ_WORD_SIZE;
+  bool indirect = raw & 1;
+  fprintf_styled_ftype out = info->fprintf_styled_func;
+
+  if (indirect)
+    out (info->stream, dis_style_text, "[");
+  out (info->stream, dis_style_address, "%s0x%lx", addr < 0 ? "-" : "",
+       (unsigned long) (addr < 0 ? - (bfd_vma) addr : (bfd_vma) addr));
+  if (indirect)
+    out (info->stream, dis_style_text, "]");
+}
+
+int
+print_insn_subleq (bfd_vma memaddr, disassemble_info *info)
+{
+  bfd_byte buf[SUBLEQ_INSN_SIZE];
+  bfd_signed_vma a, b, c;
+  unsigned int size = SUBLEQ_INSN_SIZE;
+  int status;
+  fprintf_styled_ftype out = info->fprintf_styled_func;
+
+  info->bytes_per_line = SUBLEQ_INSN_SIZE;
+  info->bytes_per_chunk = SUBLEQ_WORD_SIZE;
+  info->display_endian = BFD_ENDIAN_LITTLE;
+  info->insn_info_valid = 0;
+
+  /* Objdump bounds reads to the next symbol in a code section.  Treat
+     a partial triplet at a known static boundary as data, not code.
+     GDB's live memory reads still require a full instruction.  */
+  if (info->buffer && memaddr >= info->buffer_vma
+      && memaddr - info->buffer_vma < info->buffer_length)
+    {
+      bfd_vma available = info->buffer_length - (memaddr - info->buffer_vma);
+      if (info->stop_vma > memaddr && info->stop_vma - memaddr < available)
+        available = info->stop_vma - memaddr;
+      if (available < size || memaddr % SUBLEQ_WORD_SIZE != 0)
+        size = (available >= SUBLEQ_WORD_SIZE
+                && memaddr % SUBLEQ_WORD_SIZE == 0 ? SUBLEQ_WORD_SIZE : 1);
+    }
+
+  status = info->read_memory_func (memaddr, buf, size, info);
+  if (status != 0)
+    {
+      info->memory_error_func (status, memaddr, info);
+      return -1;
+    }
+
+  if (size < SUBLEQ_INSN_SIZE)
+    {
+      info->bytes_per_chunk = size;
+      if (size == SUBLEQ_WORD_SIZE)
+        out (info->stream, dis_style_assembler_directive, ".long\t");
+      else
+        out (info->stream, dis_style_assembler_directive, ".byte\t");
+      out (info->stream, dis_style_immediate, "0x%lx",
+           size == SUBLEQ_WORD_SIZE ? (unsigned long) bfd_getl32 (buf)
+                                    : (unsigned long) buf[0]);
+      return size;
+    }
+
+  a = bfd_getl_signed_32 (buf);
+  b = bfd_getl_signed_32 (buf + SUBLEQ_WORD_SIZE);
+  c = bfd_getl_signed_32 (buf + 2 * SUBLEQ_WORD_SIZE);
+  out (info->stream, dis_style_mnemonic, "subleq\t");
+  print_operand (a, info);
+  out (info->stream, dis_style_text, ", ");
+  print_operand (b, info);
+  out (info->stream, dis_style_text, ", ");
+  if (c >= SUBLEQ_WORD_SIZE && !(c & 1))
+    info->print_address_func (c / SUBLEQ_WORD_SIZE * SUBLEQ_WORD_SIZE, info);
+  else
+    print_operand (c, info);
+  if (!(c & 1) && c / SUBLEQ_WORD_SIZE == 0)
+    out (info->stream, dis_style_comment_start, "\t; halt");
+  return SUBLEQ_INSN_SIZE;
+}
