diff --git a/bfd/cpu-subleq.c b/bfd/cpu-subleq.c
new file mode 100644
index 0000000..b78cab5
--- /dev/null
+++ b/bfd/cpu-subleq.c
@@ -0,0 +1,24 @@
+/* BFD architecture descriptor for SUBLEQ+.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+
+#include "sysdep.h"
+#include "bfd.h"
+#include "libbfd.h"
+
+const bfd_arch_info_type bfd_subleq_arch =
+{
+  32,                          /* Bits per word.  */
+  32,                          /* Bits per address.  */
+  8,                           /* Bits per byte.  */
+  bfd_arch_subleq,
+  bfd_mach_subleq,
+  "subleq",
+  "subleq",
+  2,                           /* Word-aligned section addresses.  */
+  true,
+  bfd_default_compatible,
+  bfd_default_scan,
+  bfd_arch_default_fill,
+  NULL,
+  8                            /* Last operand is at byte offset 8.  */
+};
diff --git a/bfd/elf32-subleq.c b/bfd/elf32-subleq.c
new file mode 100644
index 0000000..16d72bd
--- /dev/null
+++ b/bfd/elf32-subleq.c
@@ -0,0 +1,81 @@
+/* BFD ELF32 support for the SUBLEQ+ Linux ABI.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+
+#include "sysdep.h"
+#include "bfd.h"
+#include "libbfd.h"
+#include "elf-bfd.h"
+#include "elf/i386.h"
+#include "elf/subleq.h"
+
+/* Canonicalize REL records for inspection.  Do not implement link-time
+   relocation: LLD (including its negated-addend support) is required.  */
+static bfd_reloc_status_type
+subleq_unsupported_reloc (bfd *abfd ATTRIBUTE_UNUSED,
+                         arelent *reloc ATTRIBUTE_UNUSED,
+                         asymbol *symbol ATTRIBUTE_UNUSED,
+                         void *contents ATTRIBUTE_UNUSED,
+                         asection *section ATTRIBUTE_UNUSED,
+                         bfd *output_bfd ATTRIBUTE_UNUSED,
+                         char **message ATTRIBUTE_UNUSED)
+{
+  return bfd_reloc_notsupported;
+}
+
+static reloc_howto_type subleq_howto_none =
+  HOWTO (R_386_NONE, 0, 0, 0, false, 0, complain_overflow_dont,
+         subleq_unsupported_reloc, "R_386_NONE", false, 0, 0, false);
+
+#define SUBLEQ_REL (0xffffffff)
+static reloc_howto_type subleq_howto_32 =
+  HOWTO (R_386_32, 0, 4, 32, false, 0, complain_overflow_dont,
+         subleq_unsupported_reloc, "R_386_32", true, SUBLEQ_REL,
+         SUBLEQ_REL, false);
+static reloc_howto_type subleq_howto_relative =
+  HOWTO (R_386_RELATIVE, 0, 4, 32, false, 0, complain_overflow_dont,
+         subleq_unsupported_reloc, "R_386_RELATIVE", true, SUBLEQ_REL,
+         SUBLEQ_REL, false);
+static reloc_howto_type subleq_howto_neg32 =
+  HOWTO (R_SUBLEQ_NEG32, 0, 4, 32, false, 0, complain_overflow_dont,
+         subleq_unsupported_reloc, "R_SUBLEQ_NEG32", true, SUBLEQ_REL,
+         SUBLEQ_REL, false);
+#undef SUBLEQ_REL
+
+static bool
+subleq_info_to_howto_rel (bfd *abfd, arelent *cache_ptr,
+                         Elf_Internal_Rela *rel)
+{
+  unsigned int type = ELF32_R_TYPE (rel->r_info);
+
+  switch (type)
+    {
+    case R_386_NONE:
+      cache_ptr->howto = &subleq_howto_none;
+      return true;
+    case R_386_32:
+      cache_ptr->howto = &subleq_howto_32;
+      return true;
+    case R_386_RELATIVE:
+      cache_ptr->howto = &subleq_howto_relative;
+      return true;
+    case R_SUBLEQ_NEG32:
+      cache_ptr->howto = &subleq_howto_neg32;
+      return true;
+    }
+  _bfd_error_handler (_("%pB: unsupported SUBLEQ relocation type %#x"),
+                      abfd, type);
+  bfd_set_error (bfd_error_bad_value);
+  return false;
+}
+
+#define ELF_ARCH                        bfd_arch_subleq
+#define ELF_MACHINE_CODE                EM_SUBLEQ
+#define ELF_MAXPAGESIZE                 0x1000
+#define TARGET_LITTLE_SYM               subleq_elf32_vec
+#define TARGET_LITTLE_NAME              "elf32-subleq"
+#define USE_REL                         1
+#define elf_info_to_howto_rel           subleq_info_to_howto_rel
+#define bfd_elf32_bfd_reloc_type_lookup  _bfd_norelocs_bfd_reloc_type_lookup
+#define bfd_elf32_bfd_reloc_name_lookup  _bfd_norelocs_bfd_reloc_name_lookup
+
+#include "elf32-target.h"
