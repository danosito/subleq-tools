--- /dev/null
+++ b/include/elf/subleq.h
@@ -0,0 +1,14 @@
+/* SUBLEQ-specific ELF definitions.
+   SPDX-License-Identifier: GPL-3.0-or-later */
+
+#ifndef _ELF_SUBLEQ_H
+#define _ELF_SUBLEQ_H
+
+#include "elf/reloc-macros.h"
+
+/* The ABI also uses R_386_NONE, R_386_32 and R_386_RELATIVE.  */
+START_RELOC_NUMBERS (elf_subleq_reloc_type)
+  RELOC_NUMBER (R_SUBLEQ_NEG32, 200)
+END_RELOC_NUMBERS (R_SUBLEQ_max)
+
+#endif /* _ELF_SUBLEQ_H */
