+#include "linux-nat.h"
+#include "nat/linux-ptrace.h"
+#include "regcache.h"
+#include "subleq-tdep.h"
+
+class subleq_linux_nat_target final : public linux_nat_target
+{
+public:
+  void fetch_registers (regcache *regs, int regnum) override;
+  void store_registers (regcache *regs, int regnum) override;
+  int can_do_single_step () override { return 0; }
+  void low_resume (ptid_t ptid, int step, gdb_signal sig) override;
+  int set_syscall_catchpoint (int pid, bool needed, int any_count,
+			      gdb::array_view<const int> counts) override;
+};
+
+static subleq_linux_nat_target the_subleq_linux_nat_target;
+
+void
+subleq_linux_nat_target::fetch_registers (regcache *regs, int regnum)
+{
+  uint32_t values[SUBLEQ_NUM_REGS];
+  int tid = get_ptrace_pid (regs->ptid ());
+  if (ptrace (PTRACE_GETREGS, tid, (PTRACE_TYPE_ARG3) 0,
+	      (PTRACE_TYPE_ARG4) values) == -1)
+    perror_with_name (_("Couldn't get SUBLEQ registers (PTRACE_GETREGS)"));
+
+  for (int i = 0; i < SUBLEQ_NUM_REGS; ++i)
+    if (regnum == -1 || regnum == i)
+      regs->raw_supply (i, &values[i]);
+}
+
+void
+subleq_linux_nat_target::store_registers (regcache *regs, int regnum)
+{
+  error (_("Writing SUBLEQ registers is not supported"));
+}
+
+void
+subleq_linux_nat_target::low_resume (ptid_t ptid, int step, gdb_signal sig)
+{
+  if (step)
+    error (_("SUBLEQ Linux does not support single-stepping"));
+  linux_nat_target::low_resume (ptid, step, sig);
+}
+
+int
+subleq_linux_nat_target::set_syscall_catchpoint
+  (int pid, bool needed, int any_count, gdb::array_view<const int> counts)
+{
+  return 1;
+}
+
+/* This configuration uses Linux LWPs without libthread_db.  */
+bool
+thread_db_notice_clone (ptid_t parent, ptid_t child)
+{
+  return false;
+}
+
+INIT_GDB_FILE (subleq_linux_nat)
+{
+  linux_target = &the_subleq_linux_nat_target;
+  add_inf_child_target (&the_subleq_linux_nat_target);
+}
