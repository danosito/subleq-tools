+#ifndef GDB_SUBLEQ_TDEP_H
+#define GDB_SUBLEQ_TDEP_H
+
+/* The stable PTRACE_GETREGS payload is the de-negated r3..pc prefix
+   of pt_regs on SUBLEQ Linux.  These are GDB register numbers, not
+   byte addresses or DWARF register numbers.  */
+enum subleq_regnum
+{
+  SUBLEQ_R3_REGNUM = 0,
+  SUBLEQ_R20_REGNUM = 17,
+  SUBLEQ_R31_REGNUM = 28,
+  SUBLEQ_FP_REGNUM,
+  SUBLEQ_SP_REGNUM,
+  SUBLEQ_RA_REGNUM,
+  SUBLEQ_PC_REGNUM,
+  SUBLEQ_NUM_REGS
+};
+
+#endif /* GDB_SUBLEQ_TDEP_H */
