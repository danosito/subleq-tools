+   along with this program.  If not, see <http://www.gnu.org/licenses/>.  */
+
+
+#include "arch-utils.h"
+#include "auxv.h"
+#include "dwarf2/frame.h"
+#include "elf/common.h"
+#include "frame-unwind.h"
+#include "gdbarch.h"
+#include "gdb_bfd.h"
+
+#include "gdbcore.h"
+#include "gdbtypes.h"
+#include "linux-tdep.h"
+#include "objfiles.h"
+#include "osabi.h"
+#include "regcache.h"
+#include "solib.h"
+#include "subleq-tdep.h"
+#include "symtab.h"
+
+static const char *
+subleq_register_name (gdbarch *arch, int regnum)
+{
+  static const char *const names[] = {
+    "r3", "r4", "r5", "r6", "r7", "r8", "r9", "r10",
+    "r11", "r12", "r13", "r14", "r15", "r16", "r17", "r18",
+    "r19", "r20", "r21", "r22", "r23", "r24", "r25", "r26",
+    "r27", "r28", "r29", "r30", "r31", "fp", "sp", "ra", "pc"
+  };
+  static_assert (ARRAY_SIZE (names) == SUBLEQ_NUM_REGS);
+  return names[regnum];
+}
+
+static type *
+subleq_register_type (gdbarch *arch, int regnum)
+{
+  if (regnum == SUBLEQ_PC_REGNUM || regnum == SUBLEQ_RA_REGNUM)
+    return builtin_type (arch)->builtin_func_ptr;
+  if (regnum == SUBLEQ_SP_REGNUM || regnum == SUBLEQ_FP_REGNUM)
+    return builtin_type (arch)->builtin_data_ptr;
+  return builtin_type (arch)->builtin_int32;
+}
+
+/* DWARF uses the word address from LLVM SubleqRegisterInfo.td, not
+   the ordinal of the register in Linux's saved context.  */
+static int
+subleq_dwarf2_reg_to_regnum (gdbarch *arch, int regnum)
+{
+  if (regnum >= 7 && regnum <= 35)
+    return SUBLEQ_R3_REGNUM + regnum - 7;
+  switch (regnum)
+    {
+    case 4: return SUBLEQ_SP_REGNUM;
+    case 5: return SUBLEQ_RA_REGNUM;
+    case 37: return SUBLEQ_FP_REGNUM;
+    default: return -1;
+    }
+}
+
+static CORE_ADDR
+subleq_skip_prologue (gdbarch *arch, CORE_ADDR pc)
+{
+  CORE_ADDR start;
+  if (find_pc_partial_function (pc, nullptr, &start, nullptr))
+    {
+      CORE_ADDR after = skip_prologue_using_sal (arch, start);
+      return std::max (pc, after);
+    }
+  return pc;
+}
+
+static enum return_value_convention
+subleq_return_value (gdbarch *arch, struct value *function,
+		     struct type *type, struct regcache *regcache,
+		     gdb_byte *readbuf, const gdb_byte *writebuf)
+{
+  if (type->length () > 4 || type->code () == TYPE_CODE_STRUCT
+      || type->code () == TYPE_CODE_UNION)
+    return RETURN_VALUE_STRUCT_CONVENTION;
+  if (readbuf != nullptr && type->length () != 0
+      && regcache->cooked_read_part (SUBLEQ_R20_REGNUM, 0,
+				     type->length (), readbuf) != REG_VALID)
+    throw_error (NOT_AVAILABLE_ERROR, _("SUBLEQ return register unavailable"));
+  if (writebuf != nullptr)
+    error (_("Writing a SUBLEQ return value is not supported"));
+  return RETURN_VALUE_REGISTER_CONVENTION;
+}
+
+static int
+subleq_breakpoint_kind_from_pc (gdbarch *arch, CORE_ADDR *pc)
+{
+  return 0;
+}
+
+static const gdb_byte *
+subleq_sw_breakpoint_from_kind (gdbarch *arch, int kind, int *size)
+{
+  *size = 0;
+  return nullptr;
+}
+
+static int
+subleq_unsupported_memory_breakpoint (gdbarch *arch, bp_target_info *bp)
+{
+  error (_("SUBLEQ Linux has no process-local software breakpoint"));
+}
+
+/* If there is no DWARF frame information, expose the stopped frame,
+   but do not guess the caller from arbitrary words in the stack.  */
+static void
+subleq_outermost_frame_id (const frame_info_ptr &frame, void **cache,
+			    frame_id *id)
+{
+  *id = outer_frame_id;
+}
+
+static struct value *
+subleq_outermost_prev_register (const frame_info_ptr &frame, void **cache,
+				int regnum)
+{
+  return frame_unwind_got_optimized (frame, regnum);
+}
+
+static const frame_unwind_legacy subleq_outermost_unwind (
+  "subleq outermost",
+  NORMAL_FRAME,
+  FRAME_UNWIND_ARCH,
+  default_frame_unwind_stop_reason,
+  subleq_outermost_frame_id,
+  subleq_outermost_prev_register,
+  nullptr,
+  default_frame_sniffer
+);
+
+/* The kernel relocates ELF images itself.  There is no user loader
+   rendezvous on which to install an SVR4 event breakpoint.  */
+struct subleq_linux_solib_ops final : solib_ops
+{
+  using solib_ops::solib_ops;
+
+  void create_inferior_hook (int from_tty) const override;
+  void relocate_section_addresses (solib &, target_section *) const override
+  { gdb_assert_not_reached ("No SUBLEQ shared library list"); }
+  owning_intrusive_list<solib> current_sos () const override
+  { return {}; }
+};
+
+void
+subleq_linux_solib_ops::create_inferior_hook (int from_tty) const
+{
+  bfd *exec = m_pspace->exec_bfd ();
+  if (exec == nullptr || (bfd_get_file_flags (exec) & DYNAMIC) == 0)
+    return;
+
+  CORE_ADDR entry;
+  if (target_auxv_search (AT_ENTRY, &entry) <= 0)
+    return;
+
+  CORE_ADDR bias = entry - bfd_get_start_address (exec);
+  objfile *obj = m_pspace->symfile_object_file;
+  if (obj != nullptr)
+    objfile_relocate (obj, std::vector<CORE_ADDR> (obj->section_offsets.size (),
+						 bias));
+  else
+    for (asection *sec : gdb_bfd_sections (exec))
+      exec_set_section_address (bfd_get_filename (exec), sec->index,
+				bfd_section_vma (sec) + bias);
+}
+
+static solib_ops_up
+subleq_linux_make_solib_ops (program_space *pspace)
+{
+  return std::make_unique<subleq_linux_solib_ops> (pspace);
+}
+
+static bool
+subleq_linux_has_shared_address_space (gdbarch *arch)
+{
+  return true;
+}
+
+/* GDB's run/starti path writes the current PC back before resuming.
+   The read-only ptrace ABI can accept that no-op, but not a jump.  */
+static void
+subleq_linux_write_pc (regcache *regs, CORE_ADDR pc)
+{
+  if (pc != regcache_read_pc (regs))
+    error (_("Writing the SUBLEQ PC is not supported"));
+}
+
+static void
+subleq_linux_init_abi (gdbarch_info info, gdbarch *arch)
+{
+  linux_init_abi (info, arch, 0);
+  set_gdbarch_write_pc (arch, subleq_linux_write_pc);
+  set_gdbarch_has_shared_address_space (arch,
+				       subleq_linux_has_shared_address_space);
+  set_gdbarch_make_solib_ops (arch, subleq_linux_make_solib_ops);
+}
+
+static gdbarch *
+subleq_gdbarch_init (gdbarch_info info, gdbarch_list *arches)
+{
+  if (info.byte_order != BFD_ENDIAN_LITTLE)
+    return nullptr;
+  if (gdbarch_list *candidate = gdbarch_list_lookup_by_info (arches, &info))
+    return candidate->gdbarch;
+
+  gdbarch *arch = gdbarch_alloc (&info, gdbarch_tdep_up ());
+  set_gdbarch_ptr_bit (arch, 32);
+  set_gdbarch_long_bit (arch, 32);
+  set_gdbarch_long_double_bit (arch, 64);
+  set_gdbarch_long_double_format (arch, floatformats_ieee_double);
+  set_gdbarch_max_insn_length (arch, 12);
+  set_gdbarch_num_regs (arch, SUBLEQ_NUM_REGS);
+  set_gdbarch_sp_regnum (arch, SUBLEQ_SP_REGNUM);
+  set_gdbarch_pc_regnum (arch, SUBLEQ_PC_REGNUM);
+  set_gdbarch_register_name (arch, subleq_register_name);
+  set_gdbarch_register_type (arch, subleq_register_type);
+  set_gdbarch_dwarf2_reg_to_regnum (arch, subleq_dwarf2_reg_to_regnum);
+  set_gdbarch_skip_prologue (arch, subleq_skip_prologue);
+  set_gdbarch_inner_than (arch, core_addr_lessthan);
+  set_gdbarch_return_value (arch, subleq_return_value);
+  set_gdbarch_breakpoint_kind_from_pc (arch, subleq_breakpoint_kind_from_pc);
+  set_gdbarch_sw_breakpoint_from_kind (arch, subleq_sw_breakpoint_from_kind);
+  set_gdbarch_memory_insert_breakpoint (arch,
+				       subleq_unsupported_memory_breakpoint);
+  set_gdbarch_memory_remove_breakpoint (arch,
+				       subleq_unsupported_memory_breakpoint);
+  gdbarch_init_osabi (info, arch);
+  dwarf2_append_unwinders (arch);
+  frame_unwind_append_unwinder (arch, &subleq_outermost_unwind);
+  return arch;
+}
+
+INIT_GDB_FILE (subleq_tdep)
+{
+  gdbarch_register (bfd_arch_subleq, subleq_gdbarch_init);
+  gdbarch_register_osabi (bfd_arch_subleq, 0, GDB_OSABI_LINUX,
+			 subleq_linux_init_abi);
+}
